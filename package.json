{
  "name": "applypack",
  "version": "2.7.0",
  "private": true,
  "description": "Runs locally with Docker: an AI console for the whole job search that finds the postings, checks they're real, scores your resume without flattering it, drafts the cover letter, tracks the application. 33 sources, 5 swappable AI backends, your data in your own Postgres, self-hosted on a VPS if you like.",
  "license": "MIT",
  "author": "Nazar Boyko (https://github.com/nazboyko)",
  "repository": {
    "type": "git",
    "url": "https://github.com/applypack/applypack.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "css": "tailwindcss -c tailwind.config.js -i src/web/tailwind.css -o src/web/public/tailwind.css --minify",
    "start": "node dist/index.js",
    "start:web": "node dist/web/server.js",
    "dev": "tsx watch src/index.ts",
    "dev:web": "tsc && node --watch --watch-path=./dist/web dist/web/server.js",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "seed": "tsx src/seed.ts",
    "fetch:once": "tsx src/scripts/fetch-once.ts",
    "digest:once": "tsx src/scripts/digest-once.ts",
    "cleanup:once": "tsx src/scripts/cleanup-once.ts",
    "stale:once": "tsx src/scripts/stale-once.ts",
    "hn:once": "tsx src/scripts/hn-once.ts",
    "discovery:once": "tsx src/scripts/discovery-once.ts",
    "priority:dryrun": "tsx src/scripts/priority-rules-dryrun.ts",
    "bench:resume": "tsx src/scripts/resume-bench-once.ts",
    "bench:screen": "tsx src/scripts/screen-bench-once.ts",
    "verify:compare": "tsx src/scripts/verify-brief-once.ts",
    "matrix:compare": "tsx src/scripts/match-matrix-once.ts",
    "variance:compare": "tsx src/scripts/match-variance-once.ts",
    "churn:compare": "tsx src/scripts/churn-once.ts",
    "keywords:audit": "tsx src/scripts/keyword-audit.ts",
    "test:telegram": "tsx src/scripts/test-telegram.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:db:push": "prisma db push",
    "lint:types": "tsc --noEmit",
    "test": "tsx --test $(find src -name '*.test.ts')",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@hono/node-server": "^1.19.17",
    "@prisma/client": "^6.1.0",
    "@xmldom/xmldom": "0.9.12",
    "docx": "9.7.1",
    "dotenv": "^16.4.5",
    "hono": "^4.13.7",
    "jszip": "3.10.1",
    "node-cron": "^3.0.3",
    "pdfkit": "0.20.2",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^6.1.0",
    "rss-parser": "^3.13.0",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
