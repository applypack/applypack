{
  "name": "applypack",
  "version": "2.43.0",
  "private": true,
  "description": "Runs on your own computer with npm start: an AI console for the whole job search that finds the postings, checks they're real, scores your resume without flattering it, drafts the cover letter, tracks the application. 33 sources, 7 swappable AI backends, your data in a Postgres of its own, Docker on a VPS if you like.",
  "license": "MIT",
  "author": "Nazar Boyko (https://github.com/nazboyko)",
  "repository": {
    "type": "git",
    "url": "https://github.com/applypack/applypack.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/resume/fonts', 'dist/resume/fonts', { recursive: true })\"",
    "css": "tailwindcss -c tailwind.config.js -i src/web/tailwind.css -o src/web/public/tailwind.css --minify",
    "start": "npm run build && node dist/local/launcher.js",
    "db": "npm run build && node dist/local/launcher.js db",
    "stop": "node dist/local/launcher.js stop",
    "db:import": "npm run build && node dist/scripts/db-import.js",
    "start:worker": "node dist/index.js",
    "start:web": "node dist/web/server.js",
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm run build && node --watch --watch-path=./dist/web dist/web/server.js",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "seed": "tsx src/seed.ts",
    "fetch:once": "tsx src/scripts/fetch-once.ts",
    "digest:once": "tsx src/scripts/digest-once.ts",
    "cleanup:once": "tsx src/scripts/cleanup-once.ts",
    "stale:once": "tsx src/scripts/stale-once.ts",
    "hn:once": "tsx src/scripts/hn-once.ts",
    "discovery:once": "tsx src/scripts/discovery-once.ts",
    "priority:dryrun": "tsx src/scripts/priority-rules-dryrun.ts",
    "bench:resume": "tsx src/scripts/resume-bench-once.ts",
    "bench:screen": "tsx src/scripts/screen-bench-once.ts",
    "verify:compare": "tsx src/scripts/verify-brief-once.ts",
    "matrix:compare": "tsx src/scripts/match-matrix-once.ts",
    "variance:compare": "tsx src/scripts/match-variance-once.ts",
    "churn:compare": "tsx src/scripts/churn-once.ts",
    "spend:report": "tsx src/scripts/ai-spend-report.ts",
    "keywords:audit": "tsx src/scripts/keyword-audit.ts",
    "exports:audit": "tsx src/scripts/dead-exports.ts",
    "smoke:routes": "node dist/scripts/route-smoke.js",
    "test:telegram": "tsx src/scripts/test-telegram.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:db:push": "prisma db push",
    "lint:types": "tsc --noEmit",
    "test": "tsx --test $(find src -name '*.test.ts')",
    "postinstall": "prisma generate"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@hono/node-server": "^2.1.1",
    "@prisma/client": "^6.1.0",
    "@xmldom/xmldom": "0.9.12",
    "docx": "9.7.2",
    "dotenv": "^18.0.4",
    "embedded-postgres": "16.14.0-beta.17",
    "hono": "^4.13.9",
    "jszip": "3.10.2",
    "node-cron": "^4.6.0",
    "pdfkit": "0.20.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.1.0",
    "rss-parser": "^3.13.0",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pdfkit": "^0.17.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
