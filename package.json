{
  "name": "job-hunter",
  "version": "0.1.0",
  "private": true,
  "description": "Local Docker worker that monitors Greenhouse / Lever / LaraJobs for senior remote-US PHP/Laravel roles and alerts via Telegram.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:web": "node dist/web/server.js",
    "dev": "tsx watch src/index.ts",
    "dev:web": "tsc && node --watch --watch-path=./dist/web dist/web/server.js",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "seed": "tsx src/seed.ts",
    "fetch:once": "tsx src/scripts/fetch-once.ts",
    "digest:once": "tsx src/scripts/digest-once.ts",
    "cleanup:once": "tsx src/scripts/cleanup-once.ts",
    "stale:once": "tsx src/scripts/stale-once.ts",
    "hn:once": "tsx src/scripts/hn-once.ts",
    "discovery:once": "tsx src/scripts/discovery-once.ts",
    "priority:dryrun": "tsx src/scripts/priority-rules-dryrun.ts",
    "test:telegram": "tsx src/scripts/test-telegram.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:db:push": "prisma db push",
    "lint:types": "tsc --noEmit",
    "test": "tsx --test $(find src -name '*.test.ts')",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^1.13.7",
    "@prisma/client": "^6.1.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.14",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^6.1.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
