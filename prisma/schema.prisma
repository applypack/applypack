generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AtsType {
  GREENHOUSE
  LEVER
  ASHBY
  LARAJOBS_RSS
  REMOTEOK
  REMOTIVE
  ARBEITNOW
  HN_HIRING
  WORKABLE
  SMARTRECRUITERS
  WEWORKREMOTELY
  GOLANGPROJECTS
  JOBICY
  HN_JOBS
  WORKINGNOMADS
  HIMALAYAS
  RECRUITEE
  BREEZY
  BAMBOOHR
  PINPOINT
  RIPPLING
  FOURDAYWEEK
  // Phase 8.2: pasted by hand on /jobs/new. One inactive Company row per
  // employer; runAllFetchers never touches it.
  MANUAL
}

enum JobStatus {
  NEW
  ALERTED
  APPLIED
  DISMISSED
  SAVED
}

enum CronRunStatus {
  RUNNING
  OK
  FAILED
}

enum CandidateStatus {
  PENDING
  PROMOTED
  IGNORED
  DEAD
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  atsType   AtsType
  atsToken  String
  active    Boolean  @default(true)
  careerUrl String?
  createdAt DateTime @default(now())
  jobs      Job[]

  @@unique([atsType, atsToken])
}

model Job {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId  String
  title       String
  url         String
  location    String
  description String    @db.Text
  postedAt    DateTime
  fetchedAt   DateTime  @default(now())
  fitScore    Int?
  salaryMin   Int?
  salaryMax   Int?
  techMatch   String[]
  redFlags    String[]
  summary     String?   @db.Text
  status      JobStatus @default(NEW)
  alertedAt   DateTime?

  // Application tracking (Phase 3.4). pipelineStage is orthogonal to status:
  //   status        = inbox state (NEW / ALERTED / SAVED / DISMISSED / APPLIED)
  //   pipelineStage = funnel state once you have actually applied
  // E.g. status=APPLIED + pipelineStage='ghosted' is a valid combo.
  appliedAt        DateTime?
  recruiterContact String?
  pipelineStage    String?
  applicationNotes String?   @db.Text

  // Phase 7.1: labels of Profile.priorityRules that matched this job at
  // classify-time and bumped fitScore to the rule's floor. Empty when no
  // rule applied. Surfaced as a badge on /jobs/:id.
  priorityRulesApplied String[] @default([])

  // F1 (ADR 0016): last liveness-ladder verdict. liveness is
  // active | expired | uncertain; livenessCode is the machine reason.
  liveness          String?
  livenessCode      String?
  livenessCheckedAt DateTime?

  resumeMatches ResumeMatch[]
  verifications JobVerification[]

  @@unique([companyId, externalId])
  @@index([status, fetchedAt])
  @@index([pipelineStage, appliedAt])
}

model CronRun {
  id           Int           @id @default(autoincrement())
  name         String
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  status       CronRunStatus @default(RUNNING)
  stats        Json?
  errorMessage String?

  @@index([name, startedAt])
  @@index([startedAt])
}

// Singleton table — always one row with id=1.
model AppSettings {
  id                             Int      @id @default(1)
  telegramEnabled                Boolean  @default(false)
  activeProfileId                Int?
  activeProfile                  Profile? @relation(fields: [activeProfileId], references: [id], onDelete: SetNull)
  // Classifier mode: 'single' = full classifier only;
  // 'two_stage' = short prefilter prompt, full classifier only on yes.
  classifierMode                 String   @default("single")
  // Phase 3.4 toggles
  applicationTrackingEnabled     Boolean  @default(true)
  staleApplicationsDigestEnabled Boolean  @default(true)
  // Phase 3.2 toggle
  hnParserEnabled                Boolean  @default(false)
  // Phase 4.1: list of AtsType values to skip in runAllFetchers, e.g.
  // ["LEVER","ARBEITNOW"]. Empty array = all enabled. Coexists with
  // per-Company.active so users can disable a whole source family with
  // one click without flipping each company toggle.
  disabledSources                String[] @default([])
  // Phase 4.2: discovery toggle (gates auto-creation of CompanyCandidate
  // rows from HN comments and the weekly probe job).
  discoveryEnabled               Boolean  @default(false)
  // Phase 7.7: master pause for new-job ingestion. When false, the hourly
  // fetch tick and the monthly HN pull exit early ("fetching-paused" in
  // /runs). Digest, stale nudge, cleanup, discovery probe, and the
  // dashboard keep running — this is the "stop the pipeline without
  // touching docker" switch. Default FALSE by user choice: deployments
  // (and the existing row, backfilled by the migration) start paused;
  // enable from /settings → "Job fetching" when ready.
  fetchingEnabled                Boolean  @default(false)
  // AI engine chain (ADR 0013/0014): { order: [provider ids by priority],
  // models: { <id>: { classifier, resume } } }. The first usable engine
  // serves each call; the rest are automatic fallbacks. NULL = follow .env
  // (AI_PROVIDER seeds a one-engine chain).
  aiEngine                       Json?
  // Lightweight AI usage counters: { "YYYY-MM-DD": { <provider>: {
  // classifier: n, resume: n } } }. Incremented atomically per successful
  // call (ai-runtime.ts:recordUsage), trimmed to 60 days by the cleanup
  // cron, summarized on /settings → AI engine.
  aiUsage                        Json?
  updatedAt                      DateTime @updatedAt
}

model CompanyCandidate {
  id           Int             @id @default(autoincrement())
  // Best-guess company name (may be null for slug-only finds).
  name         String?
  atsType      AtsType
  atsToken     String
  // Where we discovered it: "hn-2026-04", "manual", "greenhouse-list", ...
  source       String
  sourceUrl    String?
  // Free-form one-liner explaining why we flagged it.
  signal       String?
  // Last probe result: how many jobs the ATS endpoint returned.
  jobsSeen     Int             @default(0)
  status       CandidateStatus @default(PENDING)
  notes        String?
  discoveredAt DateTime        @default(now())
  promotedAt   DateTime?

  @@unique([atsType, atsToken])
  @@index([status, discoveredAt])
}

model TelegramTarget {
  id        Int       @id @default(autoincrement())
  name      String
  botToken  String
  chatId    String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  lastUsed  DateTime?
  profiles  Profile[]
}

model Profile {
  id               Int             @id @default(autoincrement())
  name             String
  // Stack tags — case-insensitive substring match on title/description.
  // stackRequired = REAL TECH (programming languages, frameworks, runtimes).
  //   The role MUST actually use one of these.
  // roleTypes     = job category hints (full-stack, backend, frontend).
  //   Used for the base filter so we don't drop "Senior Full-Stack" jobs
  //   on title alone — but Claude is told explicitly that a role-type
  //   keyword by itself is NOT a tech match.
  stackRequired    String[]
  roleTypes        String[]        @default([])
  stackNiceToHave  String[]
  stackExclude     String[]
  // Free-form context appended to Claude prompt
  notes            String?         @db.Text
  // Seniority tags: senior, staff, lead, principal, mid, junior, etc.
  seniority        String[]
  // Location preferences
  remoteOk         Boolean         @default(true)
  remoteRegions    String[] // e.g. ["US","Americas","Worldwide"]
  onsiteCities     String[] // e.g. ["Austin, TX","Berlin"]
  hybridOk         Boolean         @default(false)
  // Thresholds
  minSalaryUsd     Int             @default(0) // 0 = don't filter on salary
  minFitScore      Int             @default(70)
  // Phase 7.1: opinionated post-Claude overrides — array of
  // { label, techsAny[], regionsAny[], minFitFloor } objects validated
  // by `parsePriorityRules` in src/priority-rules.ts. When a job matches
  // a rule (≥1 tech in title/description AND ≥1 region in location),
  // fitScore is clamped up to the rule's floor and location_match is
  // forced true. Lets you say "PHP roles posted as remote-US must score
  // ≥90 even if the JD is bare-bones" without trying to convince Claude.
  priorityRules    Json            @default("[]")
  // Where alerts for this profile go. null → broadcast to all active targets.
  telegramTargetId Int?
  telegramTarget   TelegramTarget? @relation(fields: [telegramTargetId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Back-relation for AppSettings.activeProfileId
  activeFor AppSettings[]
}

// Phase 8.1: uploaded resumes. `text` is the plain-text extraction
// (docx/md/txt) every AI call reads; `original` keeps the uploaded bytes
// for download. The scan fields are filled by scanResume() and stay null
// until the first successful scan.
model Resume {
  id              Int           @id @default(autoincrement())
  name            String
  sourceFilename  String
  mimeType        String
  original        Bytes
  text            String        @db.Text
  // Bumped on "Upload new version"; matches record the version they scored.
  version         Int           @default(1)
  isDefault       Boolean       @default(false)
  // The /target scratch row: replaced in place on every ephemeral compare,
  // excluded from every list and picker.
  hidden          Boolean       @default(false)
  scannedAt       DateTime?
  title           String?
  seniority       String?
  yearsExperience Int?
  skills          String[]      @default([])
  // Subset of skills: the 2-5 core languages/frameworks of the candidate's
  // day-to-day work. Feeds Profile.stackRequired via "Fill from resume".
  primarySkills   String[]      @default([])
  roleTypes       String[]      @default([])
  summary         String?       @db.Text
  // [{ section, issue, fix }] — job-agnostic ATS / recruiter problems.
  issues          Json          @default("[]")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  matches         ResumeMatch[]
}

// Phase 8.1: one AI comparison of a resume against a job posting.
// keywords = [{ term, priority 1-4, requirement must|preferred|nice|context,
//               primary, status present|add|ask_user|cannot_claim, aliases,
//               where, note, elsewhere }]
// actions  = [{ section, where, what, why, priority high|medium|low }]
// removals = [{ section, where, what, why }] — what to delete or shorten
// Since phase 9 (ADR 0012) matchScore is computed by src/resume/score.ts from
// the keyword statuses + alignment — the model never sets the number.
model ResumeMatch {
  id               Int      @id @default(autoincrement())
  jobId            Int
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeId         Int
  resume           Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeVersion    Int      @default(1)
  // Snapshot of the text that was judged, so highlights stay true after the
  // resume moves on. `draft` = text came from the in-browser editor, not a
  // stored version.
  resumeText       String   @default("") @db.Text
  draft            Boolean  @default(false)
  model            String
  matchScore       Int
  summary          String   @db.Text
  strengths        String[] @default([])
  redFlags         String[] @default([])
  // Soft concerns — displayed, never scored (scoring v3). Red flags cost points;
  // cautions exist so the model has somewhere to put style/domain observations.
  cautions         String[] @default([])
  keywords         Json
  actions          Json
  removals         Json     @default("[]")
  // Deterministic score breakdown (ScoreBreakdown in score.ts); {} on pre-9 rows.
  breakdown        Json     @default("{}")
  // [{ requirement, status pass|unknown|fail, note }] — gates shown outside the score.
  hardRequirements Json     @default("[]")
  createdAt        DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([resumeId, createdAt])
}

// Phase 9: candidate facts confirmed or denied by the user in response to
// "ask_user" keywords. Global (single-user app), keyed by lowercase term.
// Confirmed facts count as evidence in later matches; denied terms are
// always cannot_claim and never asked again.
model CandidateFact {
  id        Int      @id @default(autoincrement())
  term      String   @unique // lowercase canonical, e.g. "azure"
  status    String // confirmed | denied
  note      String? // user's context: where / when / what
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 8.2: ghost-job / scam check of one posting, done with web search.
// evidence = [{ check, finding, url, signal legit|ghost|scam|neutral|unverified }]
model JobVerification {
  id              Int      @id @default(autoincrement())
  jobId           Int
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  model           String
  verdict         String // legit | suspicious | fake
  recommendation  String // apply | caution | skip
  confidence      Int
  summary         String   @db.Text
  evidence        Json
  redFlags        String[] @default([])
  companySnapshot String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([jobId, createdAt])
}
