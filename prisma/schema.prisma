generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AtsType {
  GREENHOUSE
  LEVER
  ASHBY
  LARAJOBS_RSS
  REMOTEOK
  REMOTIVE
  ARBEITNOW
}

enum JobStatus {
  NEW
  ALERTED
  APPLIED
  DISMISSED
  SAVED
}

enum CronRunStatus {
  RUNNING
  OK
  FAILED
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  atsType   AtsType
  atsToken  String
  active    Boolean  @default(true)
  careerUrl String?
  createdAt DateTime @default(now())
  jobs      Job[]

  @@unique([atsType, atsToken])
}

model Job {
  id          Int       @id @default(autoincrement())
  companyId   Int
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId  String
  title       String
  url         String
  location    String
  description String    @db.Text
  postedAt    DateTime
  fetchedAt   DateTime  @default(now())
  fitScore    Int?
  salaryMin   Int?
  salaryMax   Int?
  techMatch   String[]
  redFlags    String[]
  summary     String?   @db.Text
  status      JobStatus @default(NEW)
  alertedAt   DateTime?

  @@unique([companyId, externalId])
  @@index([status, fetchedAt])
}

model CronRun {
  id           Int           @id @default(autoincrement())
  name         String
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  status       CronRunStatus @default(RUNNING)
  stats        Json?
  errorMessage String?

  @@index([name, startedAt])
  @@index([startedAt])
}

// Singleton table — always one row with id=1.
model AppSettings {
  id              Int      @id @default(1)
  telegramEnabled Boolean  @default(false)
  activeProfileId Int?
  activeProfile   Profile? @relation(fields: [activeProfileId], references: [id], onDelete: SetNull)
  updatedAt       DateTime @updatedAt
}

model TelegramTarget {
  id        Int      @id @default(autoincrement())
  name      String
  botToken  String
  chatId    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  lastUsed  DateTime?
  profiles  Profile[]
}

model Profile {
  id               Int      @id @default(autoincrement())
  name             String
  // Stack tags — case-insensitive substring match on title/description
  stackRequired    String[]
  stackNiceToHave  String[]
  stackExclude     String[]
  // Free-form context appended to Claude prompt
  notes            String?  @db.Text
  // Seniority tags: senior, staff, lead, principal, mid, junior, etc.
  seniority        String[]
  // Location preferences
  remoteOk         Boolean  @default(true)
  remoteRegions    String[] // e.g. ["US","Americas","Worldwide"]
  onsiteCities     String[] // e.g. ["Austin, TX","Berlin"]
  hybridOk         Boolean  @default(false)
  // Thresholds
  minSalaryUsd     Int      @default(0)     // 0 = don't filter on salary
  minFitScore      Int      @default(70)
  // Where alerts for this profile go. null → broadcast to all active targets.
  telegramTargetId Int?
  telegramTarget   TelegramTarget? @relation(fields: [telegramTargetId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Back-relation for AppSettings.activeProfileId
  activeFor        AppSettings[]
}
