# Postgres connection. Leave it unset and `npm start` runs ApplyPack's own
# database in its data folder (ADR 0054). Set it to use a Postgres of your own;
# docker-compose sets its own for the containers.
# DATABASE_URL=postgresql://user:password@localhost:5432/applypack

# --- AI engines ------------------------------------------------------------
# Full setup guide (local + Docker, every engine): docs/ai-engines.md.
# Priority order + per-engine models live on /settings → "AI engine"
# (stored in Postgres, no restart). AI_PROVIDER only seeds the default:
# anthropic_api | claude_code | gemini_cli | openai_api | codex_cli
# The keys below are optional: the same page takes a pasted key and stores
# it in Postgres (ADR 0027), which overrides the value here. Keep them here
# if you would rather secrets stayed out of the database.
AI_PROVIDER=anthropic_api

# Anthropic API (pay per token).
ANTHROPIC_API_KEY=
# Claude model for both classifier stages (Haiku 4.5 by default).
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Claude model for resume scan + comparison (a few calls a day).
# Empty = the engine's own default (Sonnet 5 on the Claude CLI, Haiku 4.5 on the API — measured 2026-09-05).
CLAUDE_MODEL_RESUME=
# Empty = Opus 5, the strongest writer.
CLAUDE_MODEL_COVER=

# Claude Code CLI (Claude.ai subscription).
CLAUDE_CODE_BIN=claude

# Gemini CLI (Google account or API key from https://aistudio.google.com/apikey).
GEMINI_CLI_BIN=gemini
GEMINI_API_KEY=

# Antigravity CLI (Google Antigravity account: `agy` login once).
AGY_CLI_BIN=agy

# OpenAI-compatible API — works with OpenAI, OpenRouter, Groq, DeepSeek and
# local servers (LM Studio / Ollama). The server address and the key can be
# set on /settings → AI engine instead; a server on this machine needs no key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Default model for the openai_api engine when the /settings slot is empty.
OPENAI_MODEL=gpt-5-mini

# Local model through Ollama's own API (the "Local model (Ollama)" engine):
# the server and the model for an empty slot. Both can be set on /settings →
# AI engine instead. From Docker: http://host.docker.internal:11434
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_MODEL=

# Codex CLI (ChatGPT subscription): `codex login` once; in Docker mount
# ~/.codex (see docker-compose.yml).
CODEX_CLI_BIN=codex
# Jobs classified at the same time (1-8). With claude_code each one is a
# separate CLI process; with anthropic_api it is a concurrent request.
AI_CONCURRENCY=3
# Subscription token for headless use inside Docker: run `claude setup-token`
# on the host (browser login) and paste the result here. macOS keeps the
# interactive login in Keychain, so a ~/.claude volume mount does NOT work.
CLAUDE_CODE_OAUTH_TOKEN=

# Telegram bot — leave empty for now to skip alerts (notifier will log instead).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# A Discord incoming webhook (Server settings → Integrations → Webhooks → Copy URL).
# Read once on first boot like the Telegram pair; Settings → Notifications owns it after that.
DISCORD_WEBHOOK_URL=

# Logging level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Cron timezone (used by node-cron) — set to your local timezone.
TZ=UTC

# Filter thresholds (bootstrap-only; edit on /settings → Profile after first boot).
MIN_FIT_SCORE=70
# 0 = no salary filter.
MIN_SALARY_USD=0

# --- Dashboard (web service) -----------------------------------------------
# Port the Hono server listens on (inside the container).
WEB_PORT=4747
# Interface the dashboard binds to. Loopback by default: run without Docker
# and 0.0.0.0 would put an unauthenticated dashboard — jobs, resumes, settings,
# the Telegram form — on every network you join. docker-compose overrides this
# to 0.0.0.0 for the container, where the published port is already limited to
# 127.0.0.1. Change it here only with WEB_BASIC_AUTH set.
WEB_HOST=127.0.0.1
# Optional Basic Auth: "username:password". Empty = no auth (safe for loopback).
WEB_BASIC_AUTH=

# --- npm start (the built-in database) -------------------------------------
# Where the local install keeps its database, logs and lock. Empty = the
# system's application-data folder (see docs/install.md).
# APPLYPACK_DATA_DIR=/path/to/folder
# 1 = do not open the dashboard in a browser when it starts.
# APPLYPACK_NO_OPEN=1
# How many daily copies of the database folder to keep in its snapshots/
# folder, taken as the database starts. Empty = 3; 0 = none.
# APPLYPACK_SNAPSHOTS=3

# --- Docker (docker-compose.yml sets both) ---------------------------------
# production = JSON logs, one object a line; anything else = readable lines.
# NODE_ENV=production
# The worker touches this file every minute; the container healthcheck reads it.
# HEARTBEAT_FILE=/tmp/applypack-worker.heartbeat
